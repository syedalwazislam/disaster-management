# ── Selenium + headless Chrome test runner ────────────────────────────────────
FROM python:3.11-slim

# System deps + Google Chrome stable
RUN apt-get update && apt-get install -y \
        wget gnupg2 curl unzip \
        fonts-liberation libasound2 libatk-bridge2.0-0 libatk1.0-0 \
        libatspi2.0-0 libcups2 libdbus-1-3 libdrm2 libgbm1 libgtk-3-0 \
        libnspr4 libnss3 libxcomposite1 libxdamage1 libxfixes3 libxkbcommon0 \
        libxrandr2 xdg-utils --no-install-recommends \
    && rm -rf /var/lib/apt/lists/*

# Install Google Chrome
RUN wget -q -O /tmp/chrome.deb \
        https://dl.google.com/linux/direct/google-chrome-stable_current_amd64.deb \
    && apt-get install -y /tmp/chrome.deb \
    && rm /tmp/chrome.deb

# Install matching ChromeDriver via the JSON endpoint
RUN CHROME_VER=$(google-chrome --version | grep -oP '\d+\.\d+\.\d+\.\d+') \
    && CHROME_MAJOR=$(echo $CHROME_VER | cut -d. -f1) \
    && echo "Chrome $CHROME_VER  major=$CHROME_MAJOR" \
    && DRIVER_URL=$(curl -s \
        "https://googlechromelabs.github.io/chrome-for-testing/known-good-versions-with-downloads.json" \
        | python3 -c " \
import sys,json; \
data=json.load(sys.stdin); \
versions=[v for v in data['versions'] if v['version'].startswith('$(echo $CHROME_VER | cut -d. -f1).')]; \
latest=versions[-1]; \
drivers=[d for d in latest['downloads'].get('chromedriver',[]) if d['platform']=='linux64']; \
print(drivers[0]['url']) if drivers else sys.exit(1)") \
    && wget -q -O /tmp/chromedriver.zip "$DRIVER_URL" \
    && unzip /tmp/chromedriver.zip -d /tmp/chromedriver_dir \
    && find /tmp/chromedriver_dir -name "chromedriver" -exec mv {} /usr/local/bin/chromedriver \; \
    && chmod +x /usr/local/bin/chromedriver \
    && rm -rf /tmp/chromedriver.zip /tmp/chromedriver_dir

WORKDIR /tests

# Python dependencies
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# Test sources
COPY . .

# Create report output directory
RUN mkdir -p reports

# Default: run all tests with HTML + JUnit XML output
CMD ["pytest", "-v", "--tb=short", \
     "--html=reports/test_report.html", "--self-contained-html", \
     "--junitxml=reports/junit_results.xml"]
